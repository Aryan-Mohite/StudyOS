# -- LLM provider --------------------------------------------------------------
# "groq" | "gemini" | "anthropic" -- only the matching key below is required.
LLM_PROVIDER=gemini

# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=gsk_your-key-here
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL_NAME=gemini-2.0-flash

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL_NAME=claude-sonnet-4-6

PORT=8000
ENV=development
ALLOWED_ORIGINS=http://localhost:3000
VECTOR_DB_DIR=vector_db
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -- Security --------------------------------------------------------------------
# Shared secret for verifying the service-to-service JWT that Next.js sends on
# every call (see App/core/security.py). Must exactly match
# INTERNAL_SERVICE_JWT_SECRET in Frontend/.env.local. Required if ENV=production.
# Generate one with: openssl rand -hex 32
INTERNAL_SERVICE_JWT_SECRET=replace-with-openssl-rand-hex-32-output
